# Copy to .env and fill in. .env is git-ignored; never commit your API key.

# Hub serial number (the hub, or the Eddi/Zappi acting as your gateway), not a Harvi's serial.
MYENERGI_HUB_SERIAL=12345678

# Generate at myaccount.myenergi.com > Products > Advanced > "Generate new API key".
# Generating a new key cancels the old one.
MYENERGI_API_KEY=your_api_key_here

# Optional: friendly names, "serial=name" pairs separated by commas.
# A name containing "grid" also makes that Harvi the default grid Harvi in log reports.
HARVI_NAMES=1234567=Solar & Battery,7654321=Grid

# Optional: pick the grid Harvi explicitly instead (overrides the name rule).
# GRID_HARVI_SNO=7654321

# Optional: how often the live page refreshes, in seconds (default 30), and the port (default 5000).
# REFRESH_SECONDS=15
# PORT=5000
